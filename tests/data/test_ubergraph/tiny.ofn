Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/test_ubergraph>
  Declaration(Class(:A))
  Declaration(Class(:B))
  Declaration(Class(:C))
  Declaration(ObjectProperty(:part_of))
  AnnotationAssertion(rdfs:label :A "thing A")
  AnnotationAssertion(rdfs:label :B "thing B")
  AnnotationAssertion(rdfs:label :C "thing C")
  SubClassOf(:B :A)
  SubClassOf(:C :B)
  SubClassOf(:C ObjectSomeValuesFrom(:part_of :A))
)
