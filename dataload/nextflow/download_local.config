report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true

process.container = 'ghcr.io/ebispot/grebi_combined:dev'
docker.enabled = true
docker.runOptions = {
    def opts = "-u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')} -v ${System.getenv('GREBI_DOWNLOADS_PATH')}:${System.getenv('GREBI_DOWNLOADS_PATH')}"
    // Mount an out-of-tree scratch into nested containers too — see
    // local_4g_nextflow.config for why.
    def work = System.getenv('NXF_WORK') ?: ''
    if (work && !work.startsWith(System.getenv('GREBI_HOME'))) {
        opts += " -v ${work}:${work}"
    }
    return opts
}()

process {
    memory = 2.GB
    cpus = 2
}
