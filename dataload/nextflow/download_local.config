report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true

process.container = 'ghcr.io/ebispot/grebi_dataload:dev'
docker.enabled = true
docker.runOptions = "-u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')} -v ${System.getenv('GREBI_DOWNLOADS_PATH')}:${System.getenv('GREBI_DOWNLOADS_PATH')}"

process {
    memory = 2.GB
    cpus = 2
}
