report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true

process.executor = 'slurm'
process.container = 'ghcr.io/ebispot/grebi_combined:dev'
singularity.enabled = true
singularity.autoMounts = true
singularity.envWhitelist = 'PGHOST,PGPORT,PGDATABASE,PGUSER,PGPASSWORD,PGSSLMODE'

params.neo_mem = "500g"
// JVM heap for the throwaway Neo4j that serves the materialise queries. The
// run_materialised_queries process is allocated 1000.GB below, so 500g left half
// the allocation idle while capping transactions at 70% of heap = 350 GiB —
// which gwas_by_location exceeded. 800g uses the allocation properly and leaves
// ~200 GB for JVM non-heap, the page cache and the Python client.
params.neo_query_mem = "800g"
params.pg_shared_buffers = "64GB"
params.pg_work_mem = "4GB"
params.pg_maintenance_work_mem = "4GB"

// Index-build sizing for the EXTERNAL Postgres (pgsql-hlvm-138/152), which we do
// not administer and cannot resize. A parallel index build allocates a dynamic
// shared memory segment sized from maintenance_work_mem, and at 4GB x 16 workers
// the server refused it:
//   ERROR: could not resize shared memory segment ... to 4292090432 bytes:
//   No space left on device        (index_dismech_14, 2026-08-23 dataload)
// Indexes are built one at a time, so this was a single build asking for more
// shm than the host has — not contention. Kept separate from
// pg_maintenance_work_mem so the local Postgres we do control keeps its tuning
// (pg_build_maintenance_work_mem stays 64GB).
// pg_parallel_workers is only read by populate_external_postgres, so lowering it
// affects nothing else.
params.external_pg_maintenance_work_mem = "1GB"
params.pg_parallel_workers = 4
params.pg_max_wal_size = "64GB"
params.pg_build_shared_buffers = "4GB"
params.pg_build_work_mem = "4GB"
params.pg_build_maintenance_work_mem = "64GB"
params.pg_build_max_wal_size = "16GB"
params.pg_build_effective_cache_size = "256GB"
params.integration_neo_heap = "32g"
params.integration_pg_shared_buffers = "8GB"
params.integration_pg_work_mem = "1GB"
params.integration_pg_maintenance_work_mem = "4GB"
params.integration_pg_max_wal_size = "16GB"

process {
    withName: ingest {
        cpus = 4
    }
}

process {
    withName: build_equiv_groups {
        memory = 300.GB
    }
}

process {
    withName: link {
        memory = 96.GB
    }
}

process {
    withName: merge_ingests {
        memory = 256.GB
    }
}

process {
    withName: index {
        memory = 64.GB
    }
}

process {
    withName: create_neo {
        memory = 1500.GB
        cpus = 32
    }
}

process {
    withName: prepare_neo {
        memory = 16.GB
        cpus = 32
    }
}
process {
    withName: create_neo_ids_csv {
        memory = 8.GB
    }
}


process {
    withName: package_neo {
        memory = 32.GB
        cpus = 32
    }
}
process {
    withName: prepare_postgres_edges {
        memory = 16.GB
    }
}
process {
    withName: prepare_postgres_nodes {
        memory = 16.GB
    }
}
process {
    withName: create_postgres {
        memory = 1500.GB
        cpus = 32
    }
}


process {
    withName: run_materialised_queries {
        cpus = 8
        memory = 1000.GB
        stageInMode = "copy"
    }
}

process {
    withName: results_to_csv {
        memory = 150.GB
    }
}
process {
    withName: link_results {
        memory = 150.GB
    }
}

process {
    withName: construct_release {
        memory = 4.GB
    }
}
process {
    withName: package_release {
        memory = 32.GB
        cpus = 32
        time = '24h'
    }
}

process {
    withName: test_query_templates {
        memory = 150.GB
    }
}

