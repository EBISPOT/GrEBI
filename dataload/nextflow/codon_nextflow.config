process.executor = 'slurm'
process.container = 'ghcr.io/ebispot/grebi_dataload:dev'
singularity.enabled = true
singularity.autoMounts = true

params.solr_mem = "500g"
params.neo_mem = "500g"
params.neo_query_mem = "500g"

process {
    withName: build_equiv_groups {
        memory = 300.GB
    }
}

process {
    withName: link {
        memory = 96.GB
    }
}

process {
    withName: merge_ingests {
        memory = 16.GB
    }
}

process {
    withName: index {
        memory = 64.GB
    }
}

process {
    withName: create_neo {
        memory = 300.GB
        cpus = 32
    }
}

process {
    withName: create_solr_nodes_core {
        memory = 1500.GB
        cpus = 32
        scratch = "ram-disk"
    }
}
process {
    withName: create_solr_edges_core {
        memory = 1500.GB
        cpus = 32
        scratch = "ram-disk"
    }
}
process {
    withName: create_solr_autocomplete_core {
        memory = 1500.GB
        cpus = 32
        scratch = "ram-disk"
    }
}
process {
    withName: create_solr_results_cores {
        memory = 1500.GB
        cpus = 32
        scratch = "ram-disk"
    }
}


process {
    withName: create_sqlite {
        memory = 128.GB
    }
}



process {
    withName: prepare_neo {
        memory = 16.GB
        cpus = 32
    }
}
process {
    withName: prepare_solr {
        memory = 16.GB
    }
}


process {
    withName: create_neo_ids_csv {
        memory = 8.GB
    }
}


process {
    withName: package_neo {
        memory = 32.GB
        cpus = 32
    }
}
process {
    withName: package_solr {
        memory = 32.GB
        cpus = 32
    }
}


process {
    withName: run_materialised_queries {
        cpus = 8
        memory = 300.GB
        stageInMode = "copy"
    }
}

process {
    withName: results_to_csv {
        memory = 150.GB
    }
}
process {
    withName: link_results {
        memory = 150.GB
    }
}




