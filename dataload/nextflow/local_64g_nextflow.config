
process.container = 'ghcr.io/ebispot/grebi_dataload:dev'
process.containerOptions = '--user $(id -u):$(id -g)'
docker.enabled = true
docker.runOptions = "-v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')}"

params.solr_mem = "60g"
params.neo_mem = "60g"
params.neo_query_mem = "60g"


process {
    withName: create_solr_nodes_core {
        memory = 64.GB
    }
}
process {
    withName: create_solr_autocomplete_core {
        memory = 64.GB
    }
}
process {
    withName: create_solr_results_cores {
        memory = 64.GB
    }
}
process {
    withName: create_neo {
        memory = 64.GB
    }
}
process {
    withName: run_materialised_queries {
        memory = 64.GB
    }
}