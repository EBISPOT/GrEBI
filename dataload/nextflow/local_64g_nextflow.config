
report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true

process.container = 'ghcr.io/ebispot/grebi_dataload:dev'
process.containerOptions = '--user $(id -u):$(id -g)'
docker.enabled = true
docker.runOptions = {
    def opts = "--shm-size=4g -v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')} -v ${System.getenv('GREBI_DOWNLOADS_PATH')}:${System.getenv('GREBI_DOWNLOADS_PATH')} -e PGHOST -e PGPORT -e PGDATABASE -e PGUSER -e PGPASSWORD -e PGSSLMODE"
    def work = System.getenv('NXF_WORK') ?: ''
    if (work && !work.startsWith(System.getenv('GREBI_HOME'))) {
        opts += " -v ${work}:${work}"
    }
    return opts
}()

params.neo_mem = "60g"
params.neo_query_mem = "60g"
params.pg_shared_buffers = "2GB"
params.pg_work_mem = "256MB"
params.pg_maintenance_work_mem = "1GB"
params.pg_max_wal_size = "4GB"
params.pg_build_shared_buffers = "2GB"
params.pg_build_work_mem = "256MB"
params.pg_build_maintenance_work_mem = "1GB"
params.pg_build_max_wal_size = "4GB"
params.pg_build_effective_cache_size = "48GB"
params.integration_neo_heap = "4g"
params.integration_pg_shared_buffers = "1GB"
params.integration_pg_work_mem = "128MB"
params.integration_pg_maintenance_work_mem = "512MB"
params.integration_pg_max_wal_size = "2GB"

process {
    memory = 64.GB
}

process {
    withName: test_query_templates {
        memory = 16.GB
        container = 'ghcr.io/ebispot/grebi_combined:dev'
    }
}

process {
    withName: ingest {
        memory = 64.GB
    }
}
process {
    withName: assign_ids {
        memory = 64.GB
    }
}
process {
    withName: create_compressed_blobs {
        memory = 64.GB
    }
}
process {
    withName: create_neo {
        memory = 64.GB
    }
}
process {
    withName: run_materialised_queries {
        memory = 64.GB
    }
}
process {
    withName: results_to_csv {
        memory = 64.GB
    }
}
process {
    withName: add_query_metadatas_to_graph_metadata {
        memory = 64.GB
    }
}
process {
    withName: link_results {
        memory = 64.GB
    }
}
process {
    withName: csvs_to_sqlite {
        memory = 64.GB
    }
}
process {
    withName: create_postgres {
        memory = 64.GB
    }
}
process {
    withName: populate_external_postgres {
        memory = 64.GB
    }
}