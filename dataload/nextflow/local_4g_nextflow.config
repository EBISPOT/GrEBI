

// In the gh actions workflow for testing, these images are built locally
// and tagged as :dev

report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true

process.container = 'ghcr.io/ebispot/grebi_combined:dev'

docker.enabled = true
docker.runOptions = "--shm-size=256m -u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')} -v ${System.getenv('GREBI_DOWNLOADS_PATH')}:${System.getenv('GREBI_DOWNLOADS_PATH')} -e PGHOST -e PGPORT -e PGDATABASE -e PGUSER -e PGPASSWORD -e PGSSLMODE"

params.neo_mem = "1g"
params.neo_query_mem = "1g"
params.pg_shared_buffers = "128MB"
params.pg_work_mem = "64MB"
params.pg_maintenance_work_mem = "256MB"
params.pg_max_wal_size = "1GB"
params.pg_build_shared_buffers = "128MB"
params.pg_build_work_mem = "64MB"
params.pg_build_maintenance_work_mem = "256MB"
params.pg_build_max_wal_size = "1GB"
params.pg_build_effective_cache_size = "2GB"
params.integration_neo_heap = "512m"
params.integration_pg_shared_buffers = "128MB"
params.integration_pg_work_mem = "32MB"
params.integration_pg_maintenance_work_mem = "128MB"
params.integration_pg_max_wal_size = "256MB"

process {
    memory = 4.GB
}

process {
    withName: create_postgres {
        memory = 4.GB
    }
}
process {
    withName: populate_external_postgres {
        memory = 4.GB
    }
}

process {
    withName: ingest {
        memory = 4.GB
    }
}
process {
    withName: assign_ids {
        memory = 4.GB
    }
}
process {
    withName: create_compressed_blobs {
        memory = 4.GB
    }
}
process {
    withName: run_materialised_queries {
        memory = 4.GB
    }
}
process {
    withName: results_to_csv {
        memory = 4.GB
    }
}
process {
    withName: add_query_metadatas_to_graph_metadata {
        memory = 4.GB
    }
}
process {
    withName: link_results {
        memory = 4.GB
    }
}
// Cap CPUs for all processes to work in small local environments (e.g. Rancher Desktop with 2 CPUs)
process {
    withName: '.*' {
        cpus = 2
    }
}
