

// In the gh actions workflow for testing, these images are built locally
// and tagged as :dev

process.container = 'ghcr.io/ebispot/grebi_dataload:dev'
process {
    withName: run_integration_tests {
        memory = 4.GB
        container = 'ghcr.io/ebispot/grebi_combined:dev'
    }
}

process.containerOptions = '--user $(id -u):$(id -g)'
docker.enabled = true
docker.runOptions = "-v ${System.getenv('GREBI_HOME')}:${System.getenv('GREBI_HOME')}"

params.solr_mem = "2g"
params.neo_mem = "2g"
params.neo_query_mem = "2g"
params.pg_shared_buffers = "128MB"
params.pg_work_mem = "64MB"
params.pg_maintenance_work_mem = "256MB"
params.pg_max_wal_size = "1GB"
params.integration_neo_heap = "512m"
params.integration_solr_heap = "512m"
params.integration_pg_shared_buffers = "128MB"
params.integration_pg_work_mem = "32MB"
params.integration_pg_maintenance_work_mem = "128MB"
params.integration_pg_max_wal_size = "256MB"

process {
    memory = 4.GB
}

process {
    withName: ingest {
        memory = 4.GB
    }
}
process {
    withName: assign_ids {
        memory = 4.GB
    }
}
process {
    withName: create_compressed_blobs {
        memory = 4.GB
    }
}
process {
    withName: run_materialised_queries {
        memory = 4.GB
    }
}
process {
    withName: results_to_csv {
        memory = 4.GB
    }
}
process {
    withName: add_query_metadatas_to_graph_metadata {
        memory = 4.GB
    }
}
process {
    withName: link_results {
        memory = 4.GB
    }
}
process {
    withName: csvs_to_sqlite {
        memory = 4.GB
    }
}

// Cap CPUs for all processes to work in small local environments (e.g. Rancher Desktop with 2 CPUs)
process {
    withName: '.*' {
        cpus = 2
    }
}

