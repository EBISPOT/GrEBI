#!/usr/bin/env python3

import os
from pathlib import Path
import json
from datetime import datetime
import sys

# grebi_materialise lives next to this script; make sure it's importable
# regardless of the working directory the pipeline runs us from.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import grebi_materialise as gm

neo_mem = os.environ['NEO_MEM']
os.environ['JAVA_OPTS'] = f"--add-modules jdk.incubator.vector -Xms{neo_mem} -Xmx{neo_mem}"

# Lift the per-transaction memory caps, as 06_create_neo_db/neo4j_import.sh
# already does for the import. Neo4j defaults dbms.memory.transaction.total.max
# to 70% of heap, so a 500g heap caps transactions at 350 GiB — and a materialise
# query over the full graph blows through that: gwas_by_location died with
# "allocation of an extra 2.0 MiB would use more than the limit 350.0 GiB" after
# streaming 72.7 GB of results. The RETURN DISTINCT is what costs the memory: the
# distinct set is held server-side for the life of the query.
#
# 0 = unlimited, bounded in practice by the heap itself. These queries are the
# only thing running against this throwaway Neo4j, so there is nothing else to
# protect it from.
os.environ['NEO4J_dbms_memory_transaction_total_max'] = '0'
os.environ['NEO4J_dbms_memory_transaction_max'] = '0'

ret = os.system("neo4j start --verbose")
if ret != 0:
    print("Neo4j did not start correctly. Exiting.")
    sys.exit(1)

os.system("sleep 20")

from neo4j import GraphDatabase
import yaml

# The official driver, NOT py2neo. py2neo's Graph.run() ends in
# pull(result, -1), which buffers the whole result set client-side before
# yielding record one; on gwas_by_disease_location that stalled the client long
# enough for Neo4j's Bolt outbound-buffer throttle to sever the connection after
# its 15-minute limit ("Outbound network buffer has failed to flush"). The
# official driver streams with a bounded fetch size, so memory stays flat
# regardless of result size.
driver = GraphDatabase.driver("bolt://localhost:7687", auth=None,
                              max_connection_lifetime=24 * 3600,
                              connection_acquisition_timeout=3600)

subgraph = os.environ['GREBI_SUBGRAPH']
templates_dir = sys.argv[1]

# Allow overriding the build-size budget breach behaviour (fail by default).
budget_override = os.environ.get('GREBI_MATERIALISE_BUDGET_OVERRIDE') == 'true'

metadatas = []

# Walk the query_templates tree recursively (templates live in subdirs like
# disease/ and gwas/). Skip files starting with '_' (e.g. _topics.yaml).
template_files = []
for root, _dirs, files in os.walk(templates_dir):
    for name in sorted(files):
        if name.endswith(".yaml") and not name.startswith("_"):
            template_files.append(os.path.join(root, name))
template_files.sort(key=lambda p: os.path.basename(p))

for file in template_files:
    query_id = Path(file).stem

    template = yaml.safe_load(open(file))

    # Only templates that opt into materialisation are precomputed. Live-only
    # templates are served on demand via Cypher and skipped here.
    if not gm.is_materialised(template):
        continue

    if not gm.runs_for_subgraph(template, subgraph):
        continue

    try:
        cypher = gm.query_to_run(template)
    except Exception as e:
        print(f"ERROR deriving materialise query for {query_id}: {e}")
        raise

    start_time = datetime.now()
    print(f"Running materialised query {query_id} ({gm.serving_metadata(template).get('kind')}, mode={gm.materialise_mode(template)})")
    if os.environ.get('GREBI_DEBUG_QUERIES') == 'true':
        print(cypher)

    n = 0
    with open(f"./query_results/{query_id}.results.jsonl", "w") as f:
        # Genuine streaming: session.run() yields records as they arrive, bounded
        # by fetch_size, so peak memory is one batch rather than the whole result.
        with driver.session(fetch_size=10000) as session:
            for record in session.run(cypher):
                n = n + 1
                # record.data() recursively converts nodes/rels/maps to plain
                # Python. default=str is a safety net for anything json has no
                # native encoding for (e.g. neo4j temporal/spatial types), which
                # would otherwise abort the run hours in rather than degrade.
                json.dump(record.data(), f, skipkeys=True, default=str)
                f.write("\n")

    end_time = datetime.now()

    # Enforce the build-size budget so a new parameterised template can't silently
    # 10x the dataload. Standalone queries are hand-authored and were historically
    # unbudgeted, so only gate them if they opt in with an explicit budget_rows.
    template_mat = template.get("materialise") or {}
    apply_budget = (not gm.is_standalone(template)) or (template_mat.get("budget_rows") is not None)
    budget = gm.budget_rows(template)

    # A parameterised template that materialises nothing is almost always a broken
    # template, not an empty graph — and it fails silently: the budget check below
    # only trips on n > budget, so zero rows sails through and we publish an empty
    # table that serves empty results forever. Templates that are legitimately
    # empty for a graph can opt out with materialise.allow_empty: true.
    if n == 0 and not gm.is_standalone(template) and not template_mat.get("allow_empty"):
        msg = (f"Materialised query {query_id} produced 0 rows. This usually means the "
               f"template's domain constraint matches nothing in this graph. Set "
               f"materialise.allow_empty: true if that is expected here.")
        if budget_override:
            print("WARNING: " + msg + " (continuing: GREBI_MATERIALISE_BUDGET_OVERRIDE=true)")
        else:
            raise RuntimeError(msg)
    if apply_budget and n > budget:
        msg = (f"Materialised query {query_id} produced {n} rows, exceeding the "
               f"build-size budget of {budget}.")
        if budget_override:
            print("WARNING: " + msg + " (continuing: GREBI_MATERIALISE_BUDGET_OVERRIDE=true)")
        else:
            raise RuntimeError(msg + " Set GREBI_MATERIALISE_BUDGET_OVERRIDE=true to "
                               "override, raise materialise.budget_rows, or switch the "
                               "template to mode: counts_only.")

    # Assemble the per-query metadata. Keep title/description/uses_datasources at
    # the top level (the /tables UI + graph_metadata consumers read them there).
    mat = template.get("materialise") or {}
    query_metadata = {
        "id": query_id,
        "subgraph": subgraph,
        "title": template.get("title"),
        "description": template.get("description"),
        "uses_datasources": mat.get("uses_datasources"),
        "start_time": start_time.strftime("%Y-%m-%d %H:%M:%S"),
        "end_time": end_time.strftime("%Y-%m-%d %H:%M:%S"),
        "time": (end_time - start_time).total_seconds(),
        "num_results": n,
    }
    # Standalone materialised queries keep the browsable-table metadata shape
    # (including the query body under cypher_query, as the old materialised_queries
    # concept did).
    if gm.is_standalone(template):
        query_metadata["cypher_query"] = cypher
    query_metadata.update(gm.serving_metadata(template))

    metadatas.append(query_metadata)

    with open(f"./query_results/{query_id}.json", "w") as f:
        json.dump(query_metadata, f, skipkeys=True)

with open(f"./query_results/queries.json", "w") as f:
    json.dump(metadatas, f, skipkeys=True)

os.system("sleep 20")
os.system("neo4j stop")
os.system("sleep 20")
