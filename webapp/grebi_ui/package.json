  "scripts": {
    "build": "dotenv -e .env.$REACT_APP_ENV -e .env -- node build.mjs",
    "watch": "dotenv -e .env.$REACT_APP_ENV -e .env -- nodemon -e 'ts,tsx,js,jsx,css,md,yaml' -w src -w index.html.in -w ../../docs --exec 'npm run build'",
    "start": "dotenv -e .env.$REACT_APP_ENV -e .env -- concurrently -n 'Build,Serve' 'npm run watch' 'node dev_server.mjs'",
    "build:ebi": "REACT_APP_ENV=ebi npm run build",
    "watch:ebi": "REACT_APP_ENV=ebi npm run watch",
    "start:ebi": "REACT_APP_ENV=ebi npm run start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
